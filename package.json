{
    "name": "@zh2s/eslint-config-fsd",
    "version": "1.0.1",
    "author": "Zholobov Semyon Sergeevich <zholobovsemyonsergeevich@gmail.com>",
    "license": "MIT",
    "description": "Eslint flat config for fsd methodology",
    "keywords": [
        "eslint",
        "eslint-config",
        "eslint9",
        "flat-config",
        "feature-sliced",
        "fsd",
        "feature-sliced-design",
        "typescript",
        "react",
        "layered-architecture",
        "import-order",
        "public-api",
        "eslint-plugin"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git@github.com:ZholobovSS/eslint-config-fsd.git"
    },
    "homepage": "https://github.com/ZholobovSS/eslint-config-fsd.git",
    "type": "module",
    "files": [
        "./dist/rules/**/index.js",
        "./dist/utils/**",
        "./dist/index.js"
    ],
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc",
        "fix:eslint": "eslint --fix ./src --max-warnings 0",
        "fix:prettier": "prettier --ignore-path .gitignore \"./src/**/*.{ts,md,mdx}\" --write",
        "fix:all": "tsc --noEmit && npm run fix:eslint && npm run fix:prettier",
        "prepare": "husky",
        "pre-commit": "lint-staged"
    },
    "peerDependencies": {
        "eslint": ">=9"
    },
    "devDependencies": {
        "@types/node": "25.0.3",
        "eslint": "9.39.2",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-node": "0.3.9",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-prettier": "5.5.4",
        "husky": "9.1.7",
        "lint-staged": "16.2.7",
        "prettier": "3.7.4",
        "rimraf": "6.1.2",
        "typescript": "5.9.3",
        "typescript-eslint": "8.50.0"
    },
    "dependencies": {
        "eslint-plugin-boundaries": "5.3.1",
        "eslint-plugin-import": "2.32.0",
        "eslint-import-resolver-typescript": "4.4.4"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "npm run fix:eslint"
        ],
        "src/**/*.{ts,md,mdx}": [
            "npm run fix:prettier"
        ]
    }
}
