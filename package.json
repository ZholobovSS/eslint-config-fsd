{
    "name": "@zh2s/eslint-config-fsd",
    "version": "2.0.0",
    "author": "Zholobov Semyon Sergeevich <zholobovsemyonsergeevich@gmail.com>",
    "license": "MIT",
    "description": "Eslint flat config for fsd methodology",
    "keywords": [
        "eslint",
        "eslint-config",
        "eslint10",
        "flat-config",
        "feature-sliced",
        "fsd",
        "feature-sliced-design",
        "typescript",
        "react",
        "layered-architecture",
        "import-order",
        "public-api",
        "eslint-plugin"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git@github.com:ZholobovSS/eslint-config-fsd.git"
    },
    "homepage": "https://github.com/ZholobovSS/eslint-config-fsd.git",
    "type": "module",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "26.13.1",
            "onFail": "error"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "tsc",
        "prepack": "npm run build",
        "fix:eslint": "eslint --fix ./src --max-warnings 0",
        "fix:prettier": "prettier --ignore-path .gitignore \"./src/**/*.{ts,md,mdx}\" --write",
        "fix:all": "tsc --noEmit && npm run fix:eslint && npm run fix:prettier",
        "prepare": "husky",
        "pre-commit": "lint-staged"
    },
    "peerDependencies": {
        "eslint": "^10.0.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-node": "0.4.0",
        "eslint-plugin-prettier": "5.5.7",
        "globals": "17.14.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.1",
        "prettier": "3.10.1",
        "rimraf": "6.1.4",
        "typescript": "6.0.3",
        "typescript-eslint": "8.73.0"
    },
    "dependencies": {
        "eslint-plugin-boundaries": "7.4.4",
        "eslint-plugin-import-x": "4.18.1",
        "eslint-import-resolver-typescript": "4.4.5"
    },
    "lint-staged": {
        "src/**/*.ts": [
            "npm run fix:eslint"
        ],
        "src/**/*.{ts,md,mdx}": [
            "npm run fix:prettier"
        ]
    }
}
